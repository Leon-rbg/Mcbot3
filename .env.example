# Minecraft Java server (use a server you own or have permission to access)
MC_HOST=127.0.0.1
MC_PORT=25565
MC_VERSION=26.1

# Use "offline" ONLY if the server itself is configured for offline-mode
# For Microsoft-authenticated accounts, set MC_AUTH=microsoft and follow Mineflayer's auth docs.
MC_AUTH=offline

# Comma-separated bot names. Each bot needs a unique name.
BOT_NAMES=TownMiner,TownBuilder,TownFarmer

# Your Minecraft username(s) allowed to control bots in chat
CONTROLLER_NAMES=YourMinecraftName

# Optional Ollama endpoint. Leave blank to use rule-based planning only.
# For Ollama running on the same machine: http://127.0.0.1:11434
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b

# Safety limits
MAX_BOTS=3
RECONNECT=true
RECONNECT_DELAY_MS=10000
